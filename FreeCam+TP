-- ===================== LOOK / MOVE =====================
local function anglesFromCFrame(cf)
	local look = cf.LookVector
	local y = math.atan2(-look.X, -look.Z)
	local p = math.asin(math.clamp(look.Y, -1, 1))
	return y, p
end

local function setHint(text)
	hint.Text = text
	hint.Visible = freeCamOn and text ~= ""
end

local function updateStatus()
	if freeCamOn then
		status.Text = "ON"
		status.TextColor3 = Color3.fromRGB(90, 255, 150)
		toggleBtn.Text = "CLOSE"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
		tpBtn.Visible = true
		cross.Visible = true
		stickRoot.Visible = UserInputService.TouchEnabled
		if UserInputService.TouchEnabled then
			setHint("摇杆=准星方向前后左右 · 上下/左右滑动转视角 · TP CENTER 传送")
		else
			setHint("WASD 移动 · 空格/Ctrl升降 · 鼠标转视角 · TP CENTER 传送 · CLOSE 退出")
		end
	else
		status.Text = "OFF"
		status.TextColor3 = Color3.fromRGB(255, 120, 120)
		toggleBtn.Text = "OPEN"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 120, 255)
		tpBtn.Visible = false
		cross.Visible = false
		stickRoot.Visible = false
		setHint("")
	end
end

local function stopFreeCam()
	if not freeCamOn then return end
	freeCamOn = false
	clearLoop()
	ContextActionService:UnbindAction("FreeCamBlockJump")

	camera.CameraType = savedCameraType or Enum.CameraType.Custom
	if savedCameraSubject then
		camera.CameraSubject = savedCameraSubject
	end

	freezeCharacter(false)
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true

	for k in pairs(moveKeys) do moveKeys[k] = false end
	stickVec = Vector2.zero
	lookDelta = Vector2.zero
	stickKnob.Position = UDim2.fromScale(0.5, 0.5)
	updateStatus()
end

local function startFreeCam()
	if freeCamOn then return end
	getCharParts()
	if not root or not humanoid then return end

	freeCamOn = true
	savedCameraType = camera.CameraType
	savedCameraSubject = camera.CameraSubject

	camCFrame = camera.CFrame
	yaw, pitch = anglesFromCFrame(camCFrame)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(camCFrame.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	freezeCharacter(true)

	if not UserInputService.TouchEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end

	ContextActionService:BindAction("FreeCamBlockJump", function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)

	bindLoop(RunService.RenderStepped:Connect(function(dt)
		if not freeCamOn then return end

		if lookDelta.Magnitude > 0 then
			local sensX = UserInputService.TouchEnabled and LOOK_SENS_TOUCH or LOOK_SENS_PC
			local sensY = UserInputService.TouchEnabled and LOOK_SENS_TOUCH_Y or LOOK_SENS_PC
			-- swipe left/right = yaw, swipe up/down = pitch
			yaw = yaw - math.rad(lookDelta.X * sensX)
			pitch = pitch - math.rad(lookDelta.Y * sensY)
			pitch = math.clamp(pitch, math.rad(-89), math.rad(89))
			lookDelta = Vector2.zero
		end

		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		-- axes from current view center (crosshair forward)
		local right = rot.RightVector
		local look = rot.LookVector
		local up = Vector3.yAxis

		local wish = Vector3.zero
		if moveKeys.W then wish = wish + look end
		if moveKeys.S then wish = wish - look end
		if moveKeys.A then wish = wish - right end
		if moveKeys.D then wish = wish + right end
		if moveKeys.E then wish = wish + up end
		if moveKeys.Q then wish = wish - up end

		-- stick: forward/back along look (center ray), left/right along camera right
		if stickVec.Magnitude > 0.05 then
			wish = wish + look * (-stickVec.Y) + right * stickVec.X
		end

		if wish.Magnitude > 0 then
			wish = wish.Unit * MOVE_SPEED * dt
			camCFrame = CFrame.new(camCFrame.Position + wish) * rot
		else
			camCFrame = CFrame.new(camCFrame.Position) * rot
		end
		camera.CFrame = camCFrame

		if root and root.Parent then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end))

	updateStatus()
end

local function toggleFreeCam()
	if freeCamOn then
		stopFreeCam()
	else
		startFreeCam()
	end
end

local function teleportCenter()
	if not freeCamOn then return end
	getCharParts()
	if not root or not humanoid then return end

	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = false

	local result = workspace:Raycast(origin, dir * RAY_DIST, params)
	local target
	if result then
		target = result.Position + result.Normal * 3 + Vector3.new(0, 3, 0)
	else
		target = origin + dir * 80
	end

	root.Anchored = false
	root.CFrame = CFrame.new(target) * CFrame.Angles(0, yaw, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	-- auto close freecam + hide crosshair
	stopFreeCam()
end

