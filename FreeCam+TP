local MOVE_SPEED = 48
local LOOK_SENS_PC = 0.22
local LOOK_SENS_TOUCH = 0.20
local LOOK_SENS_TOUCH_Y = 0.24  -- vertical swipe pitch
local RAY_DIST = 2000
local GUI_NAME = "FreeCamTeleportGui"
-- ==================================================

