	if input.KeyCode == Enum.KeyCode.D then moveKeys.D = false end
	if input.KeyCode == Enum.KeyCode.Q then moveKeys.Q = false end
	if input.KeyCode == Enum.KeyCode.E then moveKeys.E = false end
	if input.KeyCode == Enum.KeyCode.Space then moveKeys.E = false end
	if input.KeyCode == Enum.KeyCode.LeftControl then moveKeys.Q = false end
end))

bindInput(UserInputService.InputChanged:Connect(function(input)
	if not freeCamOn then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		lookDelta = lookDelta + Vector2.new(input.Delta.X, input.Delta.Y)
	end
end))

-- touch tracking by stable key (some executors break object equality)
local stickTouchKey = nil
local lookTouchKey = nil
local stickCenter = Vector2.zero
local STICK_RADIUS = 52
local lastTouchPos = {}

local function touchKey(input)
	return tostring(input)
end

local function inStick(pos)
	local abs = stickRoot.AbsolutePosition
	local size = stickRoot.AbsoluteSize
	return pos.X >= abs.X and pos.X <= abs.X + size.X and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y
end

local function inBar(pos)
	local barAbs, barSize = bar.AbsolutePosition, bar.AbsoluteSize
	return pos.X >= barAbs.X and pos.X <= barAbs.X + barSize.X and pos.Y >= barAbs.Y and pos.Y <= barAbs.Y + barSize.Y
end

bindInput(UserInputService.InputBegan:Connect(function(input, gp)
	if not freeCamOn then return end
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	local pos = input.Position
	local key = touchKey(input)
	lastTouchPos[key] = Vector2.new(pos.X, pos.Y)

	if stickRoot.Visible and inStick(pos) then
		stickTouchKey = key
		local abs = stickBg.AbsolutePosition
		local size = stickBg.AbsoluteSize
		stickCenter = Vector2.new(abs.X + size.X / 2, abs.Y + size.Y / 2)
	elseif not inBar(pos) then
		-- any non-stick, non-bar touch starts look drag (up/down + left/right)
		lookTouchKey = key
	end
end))

bindInput(UserInputService.InputChanged:Connect(function(input, gp)
	if not freeCamOn then return end
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	local key = touchKey(input)
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	local prev = lastTouchPos[key] or pos
	local delta = pos - prev
	lastTouchPos[key] = pos

	if stickTouchKey and key == stickTouchKey then
		local d = pos - stickCenter
		if d.Magnitude > STICK_RADIUS then
			d = d.Unit * STICK_RADIUS
		end
		stickKnob.Position = UDim2.fromScale(0.5, 0.5) + UDim2.fromOffset(d.X, d.Y)
		-- Y up on screen = stick forward = move toward crosshair
		stickVec = Vector2.new(d.X / STICK_RADIUS, d.Y / STICK_RADIUS)
	elseif lookTouchKey and key == lookTouchKey then
		-- prefer engine delta; fallback to manual pos delta for vertical swipe
		local dx = input.Delta.X
		local dy = input.Delta.Y
		if math.abs(dx) < 0.001 and math.abs(dy) < 0.001 then
			dx, dy = delta.X, delta.Y
		end
		lookDelta = lookDelta + Vector2.new(dx, dy)
	end
end))

bindInput(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	local key = touchKey(input)
	lastTouchPos[key] = nil
	if stickTouchKey and key == stickTouchKey then
		stickTouchKey = nil
		stickVec = Vector2.zero
		stickKnob.Position = UDim2.fromScale(0.5, 0.5)
	end
	if lookTouchKey and key == lookTouchKey then
		lookTouchKey = nil
	end
end))

